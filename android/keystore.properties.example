# Copy this file to android/keystore.properties (gitignored) for local Release APK / AAB signing.
# NEVER commit android/keystore.properties or your .jks keystore file to version control.
#
# Generate a release keystore with:
#   keytool -genkey -v -keystore android/nexora-release.jks -alias nexora -keyalg RSA -keysize 2048 -validity 10000

storeFile=../nexora-release.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=nexora
keyPassword=CHANGE_ME_KEY_PASSWORD
